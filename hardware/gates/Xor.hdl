/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Nand(
        a = a,
        b = b,
        out = NANDout
    );

    Or(
        a = a,
        b = b,
        out = ORout
    );

    And(
        a = NANDout,
        b = ORout,
        out = out
    );
}