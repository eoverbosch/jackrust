/**
 * Computes the sum of three bits.
 */
CHIP FullAdder {
    IN a, b, c;  // 1-bit inputs
    OUT sum,     // Right bit of a + b + c
        carry;   // Left bit of a + b + c

    PARTS:
    HalfAdder(
        a = a,
        b = b,
        sum = halfsum,
        carry = halfcarry
    );

    Xor(
        a = halfsum, 
        b = c, 
        out = sum 
    );

    And(
        a = halfsum, 
        b = c, 
        out = andcarry 
    );

    Or(
        a = andcarry,
        b = halfcarry,
        out = carry
    );
}