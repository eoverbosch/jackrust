// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Not(
        in = sel,
        out = NOTsel
    );

    And(
        a = a,
        b = NOTsel,
        out = outa
    );

    And(
        a = b,
        b = sel,
        out = outb
    );

    Or(
        a = outa,
        b = outb,
        out = out,
    );
}