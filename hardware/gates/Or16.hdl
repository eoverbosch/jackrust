/**
 * 16-bit Or gate:
 * for i = 0, ..., 15:
 * out[i] = a[i] Or b[i] 
 */
CHIP Or16 {
    IN a[16], b[16];
    OUT out[16];

    PARTS:
    Not16(
        in = a, 
        out = NOTa
    );

    Not16(
        in = b, 
        out = NOTb
    );

    And16(
        a = NOTa,
        b = NOTb,
        out = ANDab
    );

    Not16(
        in = ANDab,
        out = out
    );
}